    {
      "parameters": {
        "jsCode": "const newLeads = $input.all(0).map(i => i.json);\nconst existingRows = $input.all(1).map(i => i.json);\n\nconst existingKeys = new Set();\nfor (const row of existingRows) {\n  const page = (row['Page Link'] || row.page_link || '').trim().toLowerCase();\n  const business = (row['Business Name'] || row.business_name || '').trim().toLowerCase();\n  if (page || business) existingKeys.add(`${page}::${business}`);\n}\n\nconst seenInRun = new Set();\nconst unique = [];\n\nfor (const lead of newLeads) {\n  const page = (lead.page_link || '').trim().toLowerCase();\n  const business = (lead.business_name || '').trim().toLowerCase();\n  const key = `${page}::${business}`;\n\n  if (!page && !business) continue;\n  if (existingKeys.has(key) || seenInRun.has(key)) continue;\n\n  seenInRun.add(key);\n  unique.push({ json: lead });\n}\n\nreturn unique;"
      },
