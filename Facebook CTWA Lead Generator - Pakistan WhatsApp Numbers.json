    {
      "parameters": {
        "url": "=https://graph.facebook.com/{{$json.apiVersion}}/ads_archive",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
