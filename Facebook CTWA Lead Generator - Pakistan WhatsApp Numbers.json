      "id": "1f27db6f-e008-4e7a-8ffd-9ad01fd44a8c",
      "name": "Fetch Ads by Keyword (Paginated)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        -20
      ],
      "credentials": {
        "httpQueryAuth": {
