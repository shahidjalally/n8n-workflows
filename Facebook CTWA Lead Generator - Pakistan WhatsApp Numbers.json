    {
      "parameters": {
        "jsCode": "const keyword = $json.keywords || '';\nconst payload = $json.data || [];\n\nif (!Array.isArray(payload) || payload.length === 0) {\n  return [];\n}\n\nreturn payload.map(ad => ({\n  json: {\n    ...ad,\n    keyword\n  }\n}));"
      },
      "id": "6ea695b7-b6c6-4180-bab3-76ab30c8d2f5",
      "name": "Flatten Ads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst cutoffDate = new Date(now);\ncutoffDate.setDate(cutoffDate.getDate() - 14);\n\nconst whatsappTerms = [\n  'whatsapp', 'wa.me', 'whats app', 'click to whatsapp', 'message on whatsapp',\n  '\u0648\u0627\u062a\u0633', '\u0648\u0627\u0679\u0633', '\u0648\u0627\u0679\u0633 \u0627\u06cc\u067e'\n];\n\nconst pageMap = new Map();\n\nfunction adText(ad) {\n  const bodies = Array.isArray(ad.ad_creative_bodies) ? ad.ad_creative_bodies : [];\n  const caps = Array.isArray(ad.ad_creative_link_captions) ? ad.ad_creative_link_captions : [];\n  return [...bodies, ...caps].join(' ').toLowerCase();\n}\n\nfor (const item of items) {\n  const ad = item.json;\n  if (!ad.page_id) continue;\n\n  const start = ad.ad_delivery_start_time ? new Date(ad.ad_delivery_start_time) : null;\n  if (start && start < cutoffDate) continue;\n\n  if (!pageMap.has(ad.page_id)) {\n    pageMap.set(ad.page_id, {\n      business_name: ad.page_name || 'Unknown',\n      page_link: `https://fb.com/${ad.page_id}`,\n      active_ads_count: 0,\n      has_whatsapp: false,\n      first_seen: ad.ad_delivery_start_time || '',\n      sample_text: '',\n      keywords: new Set()\n    });\n  }\n\n  const row = pageMap.get(ad.page_id);\n  row.active_ads_count += 1;\n  if (ad.keyword) row.keywords.add(ad.keyword);\n\n  const txt = adText(ad);\n  const hasWA = whatsappTerms.some(term => txt.includes(term));\n  if (hasWA) {\n    row.has_whatsapp = true;\n    if (!row.sample_text) row.sample_text = txt.slice(0, 500);\n  }\n\n  if (ad.ad_delivery_start_time && (!row.first_seen || ad.ad_delivery_start_time < row.first_seen)) {\n    row.first_seen = ad.ad_delivery_start_time;\n  }\n}\n\nconst output = [];\nfor (const row of pageMap.values()) {\n  if (row.active_ads_count >= 3 && row.has_whatsapp) {\n    output.push({\n      business_name: row.business_name,\n      page_link: row.page_link,\n      ad_creative: row.sample_text || 'whatsapp intent detected',\n      active_ads: row.active_ads_count,\n      start_date: (row.first_seen || '').slice(0,10),\n      keyword_matched: [...row.keywords].join(', '),\n      whatsapp_number: '',\n      status: 'new',\n      fetched_at: new Date().toISOString()\n    });\n  }\n}\n\nreturn output.map(json => ({ json }));"
      },
