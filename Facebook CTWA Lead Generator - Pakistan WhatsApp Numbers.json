              "value": "={{$json.adType || \"ALL\"}}"
            },
            {
              "name": "search_type",
              "value": "={{$json.searchType || \"KEYWORD_UNORDERED\"}}"
            },
            {
              "name": "fields",
              "value": "id,page_id,page_name,ad_creative_bodies,ad_creative_link_captions,ad_delivery_start_time,publisher_platforms"
            },
            {
              "name": "limit",
