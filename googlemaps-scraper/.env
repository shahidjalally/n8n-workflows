# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Scraper Configuration
MAX_RETRIES=3
# A crashed Playwright page triggers a full Chromium recycle before retrying.
RETRY_DELAY=2000
TIMEOUT=30000
HEADLESS=true
SLOW_MO=100

# Rate Limiting (optional)
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=10

# File Storage (optional)
DATA_DIR=/var/lib/googlemaps-scraper
